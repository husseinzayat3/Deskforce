# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# package-lock.json and electron/package-lock.json are committed on purpose: `npm ci` in CI
# and the release workflow installs exactly what they pin.

# dependencies
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/.next-desktop/

# desktop app
/dist-desktop/
/build-desktop/
/out/

# production
/build

# caches
.eslintcache
*.tsbuildinfo

# misc
.DS_Store
Thumbs.db

# editors (shared VS Code recommendations stay)
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Claude Code's personal settings
.claude/settings.local.json

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# vercel
.vercel

# typescript
next-env.d.ts

# secret files (.env.local and other .env variants included)
.env*
!.env.example
*.key
*.pem
*serviceAccount*.json
.firebaserc

# signing certificates for the desktop app
*.p12
*.pfx
*.cer
*.mobileprovision
*.provisionprofile

# workspace: office data and projects stay on this machine
workspace/*
!workspace/.gitkeep
