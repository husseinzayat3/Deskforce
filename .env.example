# Copy this file to .env.local and fill in the keys for the providers you use.
# .env.local is ignored by git. A provider without a key returns mock responses.

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# xAI Grok (https://console.x.ai)
GROK_API_KEY=

# Optional: use different models. Cost estimates use the prices in src/lib/officeConfig.ts,
# so add the model's price there if it is not listed.
# OPENAI_MODEL=gpt-4o-mini
# GROK_MODEL=grok-3

# Ollama needs no key. Uncomment to change where it runs, which model it uses,
# or how much context it gets (the project files are sent with every task).
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3
# OLLAMA_NUM_CTX=8192
