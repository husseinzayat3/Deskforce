# Copy this file to .env.local and fill in the keys for the providers you use.
# .env.local is ignored by git. A provider without a key returns mock responses.

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# xAI Grok (https://console.x.ai)
GROK_API_KEY=

# Anthropic Claude (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: use different models. Cost estimates use the prices in src/lib/officeConfig.ts,
# so add the model's price there if it is not listed.
# These are the defaults for employees hired without a model of their own.
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-opus-5-5
# GEMINI_MODEL=gemini-2.5-flash
# GROK_MODEL=grok-3

# Ollama needs no key. Uncomment to change where it runs, which model it uses,
# or how much context it gets (the project files are sent with every task).
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3
# OLLAMA_NUM_CTX=8192

# The office answers only when addressed as localhost / 127.0.0.1. Add other host names
# (comma-separated) only if you put it behind something that handles logins.
# OFFICE_ALLOWED_HOSTS=office.example.internal

# Agents may search the web and read public pages (on by default). Searches run through
# Anthropic, OpenAI or Gemini, whichever has a key. Can also be switched in the app's settings.
# OFFICE_WEB_ACCESS=off

# Let the office run a project's syntax checks and tests on this computer (off by default).
# OFFICE_ALLOW_CHECKS=on

# New tasks start with a plan you approve (on by default). Can be switched in the app's settings,
# and chosen per task.
# OFFICE_PLAN_FIRST=off

# Slack (see the README): an app-level token, a bot token, and who may give instructions.
# Easier to enter in the app's settings.
# SLACK_APP_TOKEN=xapp-...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_ALLOWED_USERS=U012AB3CD
